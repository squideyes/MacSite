@inherits LayoutComponentBase

<div class="page">
    <AnnouncementBar />
    <SiteHeader Solid="@Solid" />

    <main id="main">
        @Body
    </main>

    <SiteFooter />
    <DesignOverlay />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Pages can request the light/solid header via a cascading value (set in Phase 5).
    [CascadingParameter] public bool Solid { get; set; }
}
