<section class="pslider section" data-carousel data-cr-mode="slide"
         data-cr-autoplay="@(Config.Autoplay ? "true" : "false")" data-cr-interval="@Config.IntervalMs">
    <div class="container pslider__head">
        <div class="pslider__heading">
            <p class="eyebrow">Marie's Visual Portfolio</p>
            <h2 class="section-heading">Theatrical Designs</h2>
        </div>

        <div class="pslider__controls">
            <button class="pslider__arrow" data-cr-prev aria-label="Previous">&#8249;</button>
            <button class="pslider__arrow" data-cr-next aria-label="Next">&#8250;</button>
            <a class="filterby" href="/portfolio">FILTER BY <span class="filterby__caret">▾</span></a>
        </div>
    </div>

    <div class="pslider__viewport">
        <div class="pslider__track" data-cr-track>
            @foreach (var p in Productions)
            {
                <div class="pslider__cell">
                    <PortfolioCard Production="p" />
                </div>
            }
        </div>
    </div>

    <div class="container pslider__foot">
        <a class="btn btn--solid" href="/portfolio">View All Portfolio</a>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Production> Productions { get; set; } = [];
    [Parameter] public SectionConfig Config { get; set; } = new() { Key = SectionConfig.Slider };
}
