@rendermode InteractiveServer
@inject ISubscriberRepository Subscribers

<div class="signup">
    @if (_done)
    {
        <p class="signup__done">Thank you — you're on the list.</p>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="signup__form" FormName="newsletter">
            <DataAnnotationsValidator />
            <div class="signup__field">
                <span class="signup__icon"><img src="/icons/email.svg" alt="" width="18" height="14" /></span>
                <InputText @bind-Value="_model.Email" type="email" class="signup__input" placeholder="Enter your email..." autocomplete="email" />
                <button type="submit" class="signup__btn">Sign Up</button>
            </div>
            <ValidationMessage For="() => _model.Email" />
        </EditForm>
    }
</div>

@code {
    private readonly Model _model = new();
    private bool _done;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Email)) return;
        await Subscribers.AddAsync(_model.Email);
        _done = true;
    }

    private sealed class Model
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
