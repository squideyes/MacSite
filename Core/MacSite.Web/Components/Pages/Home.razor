@page "/"
@inject SiteContentService Content
@inject IHeroSlideRepository HeroRepo
@inject IProductionRepository ProductionRepo
@inject IPressRepository PressRepo
@inject ITestimonialRepository TestimonialRepo
@inject IDownloadRepository DownloadRepo

<PageTitle>Marie Anne Chiment — Set &amp; Costume Design</PageTitle>

<HeroSlider Slides="_heroSlides"
            Headline="@_settings.DefaultHeroHeadline"
            VideoUrl="@_settings.HeroVideoUrl"
            VideoBadgeText="@_settings.HeroVideoBadgeText"
            Config="_heroConfig" />

<PortfolioSlider Productions="_sliderProductions" Config="_sliderConfig" />

<BioSection BrandName="@_settings.BrandName"
            Body="@_settings.BioBody"
            PortraitUrl="@_settings.PortraitImageUrl"
            CvUrl="@_settings.CvFileUrl" />

<SpotlightSection Items="_press" />

<ApplauseSlider Items="_testimonials" Config="_applauseConfig" />

<DownloadsSection Resource="_publicity" NewsletterHeading="@_settings.NewsletterHeading" />

@code {
    private SiteSettings _settings = new();
    private IReadOnlyList<HeroSlide> _heroSlides = [];
    private IReadOnlyList<Production> _sliderProductions = [];
    private IReadOnlyList<PressItem> _press = [];
    private IReadOnlyList<Testimonial> _testimonials = [];
    private MediaDownload? _publicity;

    private SectionConfig _heroConfig = new() { Key = SectionConfig.Hero };
    private SectionConfig _sliderConfig = new() { Key = SectionConfig.Slider };
    private SectionConfig _applauseConfig = new() { Key = SectionConfig.Applause };

    protected override async Task OnInitializedAsync()
    {
        _settings = await Content.GetSettingsAsync();

        _heroSlides = await HeroRepo.GetActiveAsync();
        _sliderProductions = await ProductionRepo.GetForSliderAsync();
        _press = await PressRepo.GetActiveAsync();
        _testimonials = await TestimonialRepo.GetActiveAsync();
        _publicity = (await DownloadRepo.GetActiveAsync(DownloadKind.PublicityResource)).FirstOrDefault();

        _heroConfig = await Content.GetConfigAsync(SectionConfig.Hero);
        _sliderConfig = await Content.GetConfigAsync(SectionConfig.Slider);
        _applauseConfig = await Content.GetConfigAsync(SectionConfig.Applause);
    }
}
